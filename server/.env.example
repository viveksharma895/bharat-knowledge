# Server port
PORT=3001

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/bharat_knowledge

# JWT configuration
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# CORS
ADMIN_ORIGIN=http://localhost:3002

# Admin seed credentials (used by npm run seed:admin)
ADMIN_EMAIL=admin@bharatknowledge.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Administrator
